# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Optional shared secret for the API. Leave empty to disable API key auth.
# When set, every request except /health and /health/live must send the value
# in the X-API-Key header.
API_KEY=

# =============================================================================
# MongoDB Configuration
# =============================================================================
# URI used by the backend service to connect to MongoDB.
MONGODB_URI=mongodb://mongodb:27017/monitoring_db

# =============================================================================
# Google Sheets (CSV Export)
# =============================================================================
# Publicly shared Google Sheet CSV export URL.
# Format: https://docs.google.com/spreadsheets/d/{SHEET_ID}/export?format=csv
# The sheet must be shared with "Anyone with the link can view" and contain
# at minimum a "url" column (recommended: name, url, expectedStatusCode).
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv

# =============================================================================
# Scanning Configuration
# =============================================================================
# Cron expression for the periodic scan interval (node-schedule).
# Example: "*/5 * * * *" runs every 5 minutes.
SCAN_INTERVAL_CRON=0 * * * *

# HTTP request timeout in milliseconds for each uptime check.
SCAN_TIMEOUT_MS=10000

# Maximum number of attempts per request (1 initial + N retries) for
# network errors and 5xx responses. Request timeouts are not retried.
MAX_RETRIES=3

# Number of consecutive failed checks required before a "failure threshold"
# alert is emitted (in addition to the up->down transition alert).
CONSECUTIVE_FAILURES_THRESHOLD=3

# Maximum number of targets checked in parallel during a cycle.
SCAN_CONCURRENCY=10

# How long scan results are kept in MongoDB before the TTL index removes them.
SCAN_RETENTION_DAYS=30

# =============================================================================
# Email Alerts (SMTP via nodemailer)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to "true" for TLS (port 465), "false" for STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Display name + address used as the sender.
ALERT_FROM=Uptime Monitor <alerts@yourdomain.com>
# Comma-separated list of recipient addresses.
ALERT_TO=admin@yourdomain.com
