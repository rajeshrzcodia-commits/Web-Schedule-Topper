# Backend API base URL. Leave empty in dev to use Vite proxy (relative).
# In production set to your backend origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# API key must match the backend API_KEY environment variable.
VITE_API_KEY=your-api-key-here

# Request timeout in milliseconds.
VITE_REQUEST_TIMEOUT=15000

# Google OAuth Client ID for "Continue with Gmail" sign-in.
VITE_GOOGLE_CLIENT_ID=823553511126-nb4m66oc4cdbv5sciar2a6bfai490niv.apps.googleusercontent.com