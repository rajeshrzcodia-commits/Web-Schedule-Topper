# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Optional shared secret for the API. Leave empty to disable API key auth.
API_KEY=

# =============================================================================
# Authentication Configuration
# =============================================================================
# Secret for signing session tokens. Required in production.
# A safe local fallback is used if unset, so dev never crashes.
AUTH_SECRET=your-auth-secret-change-in-production

# Google OAuth Client ID for "Continue with Gmail" (optional in dev)
GOOGLE_CLIENT_ID=823553511126-nb4m66oc4cdbv5sciar2a6bfai490niv.apps.googleusercontent.com

# Frontend URL for CORS (optional)
FRONTEND_URL=http://localhost:5001

# =============================================================================
# MongoDB Configuration (MongoDB Atlas Cloud)
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/monitoring_db

# =============================================================================
# Google Sheets (CSV Export)
# =============================================================================
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vRlGSZHror7hLxH16vIh-Y5fjCKX5vuP4lfctWUB6tFJqvDXyU-iIkrHZHrpoSu3J3FytEtWSnjeqPG/pub?gid=0&single=true&output=csv
# =============================================================================
# Scanning Configuration
# =============================================================================
SCAN_INTERVAL_CRON=0 */2 * * *
SCAN_TIMEOUT_MS=10000
MAX_RETRIES=3
CONSECUTIVE_FAILURES_THRESHOLD=3
SCAN_CONCURRENCY=10
SCAN_RETENTION_DAYS=30

# =============================================================================
# Email Alerts (SMTP via nodemailer)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_FROM=Uptime Monitor <noreply@example.com>
ALERT_TO=
